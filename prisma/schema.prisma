generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

/// Whether an account may be used, and why not if it may not.
///
/// ACTIVE     Normal.
/// SUSPENDED  Cannot sign in. Temporary and reversible. Entries and scores are
///            left alone, so no league table this manager competed in changes.
/// BLOCKED    Cannot sign in, permanently, and the email cannot register again.
/// DELETED    Soft. Gone from the manager's side and shown as a former manager
///            in public standings. Personal fields are cleared by the purge job
///            after the retention window; entries and scores stay, because
///            removing them would rewrite finished competitions.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

/// The closed set of admin actions worth recording. Anything that changes what
/// another person can do, or that moves money, belongs here.
enum AdminActionType {
  SUSPEND
  UNSUSPEND
  BLOCK
  UNBLOCK
  DELETE
  RESTORE
  PURGE
  ROLE_GRANT
  ROLE_REVOKE
  PRO_COMP
  LEAGUE_CREATE
  LEAGUE_UPDATE
  SYNC
}

/// How a manager came to hold Clashd Analysis.
enum ProSource {
  NONE
  TRIAL
  APPLE
  GOOGLE
  CLUB
  COMP
}

enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

/// Whether a competition is being paid for, and what that means for its members.
///
/// This is separate from LeagueStatus on purpose. Status answers "where is this
/// competition in its own life" (not started, running, finished). Access answers
/// "is anybody paying for it". A league can be ACTIVE and FROZEN at once: the
/// season is running, the table just stopped moving because nobody bought a pass.
///
/// FREE      Clashd's own competitions. Never paid for, never frozen.
/// TRIAL     An imported group inside its free window.
/// PAID      An imported group covered by a verified Club pass.
/// FROZEN    The free window ended and nobody paid. Scoring stops; the table
///           stays visible at the last completed gameweek. Reversible.
/// ARCHIVED  Frozen for longer than the grace period. Hidden from members, data
///           retained, still reversible by an admin.
enum LeagueAccess {
  FREE
  TRIAL
  PAID
  FROZEN
  ARCHIVED
}

// What scoring engine a league runs on. An admin can only create a league
// using a format the app already knows how to score.
enum LeagueFormat {
  SEASON_TOTAL
  WEEKLY_HIGH
  CAPTAIN_POINTS
  TRANSFER_NET
  RANK_CLIMB
  NO_HITS
  SEVEN_ASIDE
  FIVE_ASIDE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  avatarId      String?
  role          UserRole  @default(PLAYER)
  fplTeamId     Int?      @unique
  fplTeamName   String?
  fplVerifiedAt DateTime?
  platformRank  Int?
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Clashd Analysis. Written only by the RevenueCat webhook or an admin comp;
  // never by the app. Read through services/entitlements.ts, never directly.
  /// Analysis is free for a fortnight from the day an account is made, with no
  /// card and no purchase flow. Somebody has to feel what Analysis does before
  /// being asked to pay for it, and a paywall in front of a product nobody has
  /// used yet converts nobody.
  ///
  /// Null on accounts that predate this, which is deliberate: a null trial is
  /// treated as no trial rather than as an open-ended one, so an old account
  /// cannot quietly hold Analysis forever.
  trialEndsAt   DateTime?

  proUntil      DateTime?
  proSource     ProSource @default(NONE)
  proProductId  String?
  proWillRenew  Boolean   @default(false)

  // Account standing. Written only by the admin routes, read on every
  // authenticated request through services/accountStatus.ts.
  status         UserStatus @default(ACTIVE)
  /// Shown to the person when they are turned away. Keep it factual and short.
  statusReason   String?
  /// Internal only. Never leaves the server.
  statusNote     String?
  statusAt       DateTime?
  statusById     String?
  /// A suspension that lifts by itself. Null means it holds until lifted.
  suspendedUntil DateTime?
  /// When a soft delete happened. The purge job counts the window from here.
  deletedAt      DateTime?
  /// Held so a soft delete can rename the account to "Former manager"
  /// immediately, which makes every existing standings query correct with no
  /// changes to it, and a restore can put the real name back exactly.
  priorDisplayName String?

  entries       Entry[]
  notifications Notification[]
  createdLeagues League[] @relation("LeagueCreator")
  asidePicks     AsidePick[]
  squadSnapshots SquadSnapshot[]
  posts          Post[]
  billingEvents  BillingEvent[]
  clubPasses     ClubPass[]
  auditActions   AdminAuditLog[] @relation("AuditActor")
  @@index([status])
  @@map("users")
}

/// Every consequential admin action, written once and never changed. There is
/// deliberately no route that updates or deletes a row here.
///
/// The actor's email and name, and a label for the target, are stored on the row
/// rather than only joined: an audit log that becomes unreadable once an account
/// is gone is not an audit log.
model AdminAuditLog {
  id          String          @id @default(uuid())
  actorId     String?
  actor       User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorName   String
  action      AdminActionType
  /// USER, LEAGUE or SYSTEM.
  targetType  String
  targetId    String?
  targetLabel String
  /// What the admin typed as justification. Required for anything punitive.
  reason      String?
  /// Before and after values, or whatever else makes the row make sense later.
  meta        Json?
  createdAt   DateTime        @default(now())
  @@index([createdAt])
  @@index([action])
  @@index([targetId])
  @@map("admin_audit_log")
}

model League {
  id            String        @id @default(uuid())
  name          String
  inviteCode    String        @unique
  status        LeagueStatus  @default(UPCOMING)
  format        LeagueFormat  @default(SEASON_TOTAL)
  formationSpec Json?
  payingPlaces  Int           @default(1)
  description   String?
  season        String
  startGameweek Int
  endGameweek   Int
  prizeInfo     String?
  createdById   String
  createdBy     User          @relation("LeagueCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  entries       Entry[]
  gwScores      GwScore[]
  asidePicks    AsidePick[]
  divisions     Division[]
  importedFromFplId Int?      @unique

  /// Which imported suite this competition belongs to, as "fpl:<id>".
  ///
  /// An import creates nine competitions from one FPL mini-league, and a Club
  /// pass covers the whole set. Until now the set was found by matching invite
  /// codes on a shared prefix, which works until one league's code happens to be
  /// a prefix of another's, at which point a payment would unfreeze the wrong
  /// group. This makes the grouping explicit.
  ///
  /// Null for Clashd's own competitions, which belong to no suite.
  importGroupId String?

  /// Who is paying, and what members see. See the LeagueAccess enum.
  access        LeagueAccess @default(FREE)
  /// Last gameweek covered by the free window. Null for FREE competitions.
  trialEndsGw   Int?
  frozenAt      DateTime?
  /// When a frozen suite becomes archived if still unpaid.
  archiveDueAt  DateTime?
  archivedAt    DateTime?

  pendingMembers PendingMember[]
  clubPasses    ClubPass[]
  @@index([importGroupId])
  @@index([access])
  @@map("leagues")
}

model Entry {
  divisionId    String?
  division      Division?  @relation(fields: [divisionId], references: [id])
  played        Int        @default(0)
  won           Int        @default(0)
  drawn         Int        @default(0)
  lost          Int        @default(0)
  leaguePoints  Int        @default(0)
  homeFixtures  Fixture[]  @relation("HomeEntry")
  awayFixtures  Fixture[]  @relation("AwayEntry")
  id           String    @id @default(uuid())
  userId       String
  leagueId     String
  joinedAt     DateTime  @default(now())
  totalPoints  Int       @default(0)
  currentRank  Int?
  previousRank Int?
  user         User      @relation(fields: [userId], references: [id])
  league       League    @relation(fields: [leagueId], references: [id])
  gwScores     GwScore[]
  @@unique([userId, leagueId])
  @@map("entries")
}

model GwScore {
  id            String   @id @default(uuid())
  entryId       String
  leagueId      String
  gameweek      Int
  points        Int
  transfersMade Int      @default(0)
  pointsOnBench Int      @default(0)
  captainPoints Int      @default(0)
  rankInLeague  Int?
  teamSnapshot  Json?
  syncedAt      DateTime @default(now())
  entry         Entry    @relation(fields: [entryId], references: [id])
  league        League   @relation(fields: [leagueId], references: [id])
  @@unique([entryId, gameweek])
  @@map("gw_scores")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("notifications")
}

model FplSync {
  id             String   @id @default(uuid())
  gameweek       Int
  status         String
  recordsUpdated Int      @default(0)
  errorMessage   String?
  syncedAt       DateTime @default(now())
  @@map("fpl_syncs")
}

// A manager's confirmed FPL squad for a gameweek, captured once the FPL
// deadline has passed and picks become public. Used as the pool a player
// chooses their Aside team from for the FOLLOWING gameweek.
model SquadSnapshot {
  id        String   @id @default(uuid())
  userId    String
  gameweek  Int
  picks     Json
  fetchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, gameweek])
  @@index([gameweek])
  @@map("squad_snapshots")
}

// A player's Aside selection for one league in one gameweek.
// Deliberately separate from Entry/GwScore so Aside scoring can never
// interfere with season-long league scoring.
model AsidePick {
  id           String    @id @default(uuid())
  userId       String
  leagueId     String
  gameweek     Int
  playerIds    Json
  score        Int       @default(0)
  invalidCount Int       @default(0)
  scoredAt     DateTime?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  league       League    @relation(fields: [leagueId], references: [id])
  @@unique([userId, leagueId, gameweek])
  @@index([leagueId, gameweek])
  @@map("aside_picks")
}

// Admin-written posts shown in the app's News tab alongside official FPL news.
model Post {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String   @default("CLASHD")
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@map("posts")
}

// A tier within a league. Tier 1 is the top division. Members play a round
// robin against each other, then the top and bottom few move between tiers.
model Division {
  id            String    @id @default(uuid())
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id])
  tier          Int
  name          String
  cycle         Int       @default(1)
  startGameweek Int
  endGameweek   Int
  createdAt     DateTime  @default(now())
  entries       Entry[]
  fixtures      Fixture[]
  @@unique([leagueId, tier, cycle])
  @@index([leagueId])
  @@map("divisions")
}

// One head to head match in one gameweek. awayEntryId is null for a bye,
// which happens when a division has an odd number of members.
model Fixture {
  id           String    @id @default(uuid())
  divisionId   String
  division     Division  @relation(fields: [divisionId], references: [id])
  round        Int
  gameweek     Int
  homeEntryId  String
  homeEntry    Entry     @relation("HomeEntry", fields: [homeEntryId], references: [id])
  awayEntryId  String?
  awayEntry    Entry?    @relation("AwayEntry", fields: [awayEntryId], references: [id])
  homePoints   Int?
  awayPoints   Int?
  settled      Boolean   @default(false)
  settledAt    DateTime?
  createdAt    DateTime  @default(now())
  @@unique([divisionId, round, homeEntryId])
  @@index([divisionId, gameweek])
  @@index([gameweek, settled])
  @@map("fixtures")
}

// The weekly "in-form 30" intelligence, computed once per gameweek and served to
// every user. One row per gameweek holds the whole snapshot as JSON: consensus
// ownership, most transferred in/out, and the differential of the week.
model FormPickSnapshot {
  id         String   @id @default(uuid())
  gameweek   Int      @unique
  data       Json
  computedAt DateTime @default(now())
  @@map("form_pick_snapshots")
}

// A manager who belongs to an imported FPL mini-league but has not joined
// Clashd. We deliberately store ONLY their public FPL entry id -- never a name,
// team name or score -- so that no identifiable information about a
// non-consenting person is held. When they sign up and link that team they are
// placed into the league automatically and this row is removed.
model PendingMember {
  id        String   @id @default(uuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id])
  fplTeamId Int
  createdAt DateTime @default(now())
  @@unique([leagueId, fplTeamId])
  @@index([fplTeamId])
  @@map("pending_members")
}

// ---- Push notifications ----------------------------------------------------
// One row per phone. prefs holds which alerts are on: deadline, captain, results.
model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  prefs     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("push_devices")
}

// Every alert sent, keyed so the same alert is never sent twice.
model PushLog {
  id     String   @id @default(uuid())
  userId String
  key    String
  sentAt DateTime @default(now())
  @@unique([userId, key])
  @@map("push_logs")
}


/// One league's Club pass for one season. Covers the first `seats` managers to
/// have joined that league, by joinedAt. Bought by the manager who created it.
model ClubPass {
  id            String    @id @default(uuid())
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season        String
  seats         Int
  amountPence   Int
  productId     String
  store         String
  transactionId String
  purchasedById String
  purchasedBy   User      @relation(fields: [purchasedById], references: [id])
  /// False until the RevenueCat webhook confirms the same transaction.
  verified      Boolean   @default(false)
  activeFrom    DateTime  @default(now())
  activeUntil   DateTime
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([leagueId, season])
  @@index([season])
  @@index([transactionId])
  @@map("club_passes")
}

/// Every webhook RevenueCat sends, stored whole. The eventId unique constraint
/// is what makes the webhook safe to retry.
model BillingEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  type        String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  productId   String?
  store       String?
  environment String?
  expiresAt   DateTime?
  payload     Json
  createdAt   DateTime  @default(now())
  @@index([userId])
  @@index([type])
  @@map("billing_events")
}
