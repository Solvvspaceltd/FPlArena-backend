generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// What scoring engine a league runs on. An admin can only create a league
// using a format the app already knows how to score.
enum LeagueFormat {
  SEASON_TOTAL
  WEEKLY_HIGH
  CAPTAIN_POINTS
  TRANSFER_NET
  RANK_CLIMB
  NO_HITS
  SEVEN_ASIDE
  FIVE_ASIDE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  role          UserRole  @default(PLAYER)
  fplTeamId     Int?      @unique
  fplTeamName   String?
  fplVerifiedAt DateTime?
  platformRank  Int?
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  entries       Entry[]
  notifications Notification[]
  createdLeagues League[] @relation("LeagueCreator")
  asidePicks     AsidePick[]
  squadSnapshots SquadSnapshot[]
  posts          Post[]
  @@map("users")
}

model League {
  id            String        @id @default(uuid())
  name          String
  inviteCode    String        @unique
  status        LeagueStatus  @default(UPCOMING)
  format        LeagueFormat  @default(SEASON_TOTAL)
  formationSpec Json?
  payingPlaces  Int           @default(1)
  description   String?
  season        String
  startGameweek Int
  endGameweek   Int
  prizeInfo     String?
  createdById   String
  createdBy     User          @relation("LeagueCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  entries       Entry[]
  gwScores      GwScore[]
  asidePicks    AsidePick[]
  @@map("leagues")
}

model Entry {
  id           String    @id @default(uuid())
  userId       String
  leagueId     String
  joinedAt     DateTime  @default(now())
  totalPoints  Int       @default(0)
  currentRank  Int?
  previousRank Int?
  user         User      @relation(fields: [userId], references: [id])
  league       League    @relation(fields: [leagueId], references: [id])
  gwScores     GwScore[]
  @@unique([userId, leagueId])
  @@map("entries")
}

model GwScore {
  id            String   @id @default(uuid())
  entryId       String
  leagueId      String
  gameweek      Int
  points        Int
  transfersMade Int      @default(0)
  pointsOnBench Int      @default(0)
  captainPoints Int      @default(0)
  rankInLeague  Int?
  teamSnapshot  Json?
  syncedAt      DateTime @default(now())
  entry         Entry    @relation(fields: [entryId], references: [id])
  league        League   @relation(fields: [leagueId], references: [id])
  @@unique([entryId, gameweek])
  @@map("gw_scores")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("notifications")
}

model FplSync {
  id             String   @id @default(uuid())
  gameweek       Int
  status         String
  recordsUpdated Int      @default(0)
  errorMessage   String?
  syncedAt       DateTime @default(now())
  @@map("fpl_syncs")
}

// A manager's confirmed FPL squad for a gameweek, captured once the FPL
// deadline has passed and picks become public. Used as the pool a player
// chooses their Aside team from for the FOLLOWING gameweek.
model SquadSnapshot {
  id        String   @id @default(uuid())
  userId    String
  gameweek  Int
  picks     Json
  fetchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, gameweek])
  @@index([gameweek])
  @@map("squad_snapshots")
}

// A player's Aside selection for one league in one gameweek.
// Deliberately separate from Entry/GwScore so Aside scoring can never
// interfere with season-long league scoring.
model AsidePick {
  id           String    @id @default(uuid())
  userId       String
  leagueId     String
  gameweek     Int
  playerIds    Json
  score        Int       @default(0)
  invalidCount Int       @default(0)
  scoredAt     DateTime?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  league       League    @relation(fields: [leagueId], references: [id])
  @@unique([userId, leagueId, gameweek])
  @@index([leagueId, gameweek])
  @@map("aside_picks")
}

// Admin-written posts shown in the app's News tab alongside official FPL news.
model Post {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String   @default("CLASHD")
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@map("posts")
}
