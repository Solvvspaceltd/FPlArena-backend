generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum LeagueStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  role          UserRole  @default(PLAYER)
  fplTeamId     Int?      @unique
  fplTeamName   String?
  fplVerifiedAt DateTime?
  platformRank  Int?
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  entries       Entry[]
  notifications Notification[]
  createdLeagues League[] @relation("LeagueCreator")
  @@map("users")
}

model League {
  id            String        @id @default(uuid())
  name          String
  inviteCode    String        @unique
  status        LeagueStatus  @default(UPCOMING)
  description   String?
  season        String
  startGameweek Int
  endGameweek   Int
  prizeInfo     String?
  createdById   String
  createdBy     User          @relation("LeagueCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  entries       Entry[]
  gwScores      GwScore[]
  @@map("leagues")
}

model Entry {
  id           String    @id @default(uuid())
  userId       String
  leagueId     String
  joinedAt     DateTime  @default(now())
  totalPoints  Int       @default(0)
  currentRank  Int?
  previousRank Int?
  user         User      @relation(fields: [userId], references: [id])
  league       League    @relation(fields: [leagueId], references: [id])
  gwScores     GwScore[]
  @@unique([userId, leagueId])
  @@map("entries")
}

model GwScore {
  id            String   @id @default(uuid())
  entryId       String
  leagueId      String
  gameweek      Int
  points        Int
  transfersMade Int      @default(0)
  pointsOnBench Int      @default(0)
  captainPoints Int      @default(0)
  rankInLeague  Int?
  teamSnapshot  Json?
  syncedAt      DateTime @default(now())
  entry         Entry    @relation(fields: [entryId], references: [id])
  league        League   @relation(fields: [leagueId], references: [id])
  @@unique([entryId, gameweek])
  @@map("gw_scores")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("notifications")
}

model FplSync {
  id             String   @id @default(uuid())
  gameweek       Int
  status         String
  recordsUpdated Int      @default(0)
  errorMessage   String?
  syncedAt       DateTime @default(now())
  @@map("fpl_syncs")
}
